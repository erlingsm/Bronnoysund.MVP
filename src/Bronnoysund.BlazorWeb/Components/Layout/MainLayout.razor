@inherits LayoutComponentBase
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Bronnoysund.ViewModels
@using Bronnoysund.ViewModels.Resources
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject CompanyLookupViewModel ViewModel

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="OnTitleClick"
                   Class="text-h6 text-transform-none pa-2"
                   aria-label="@L["TitleResetAriaLabel"]">
            @L["AppTitle"]
        </MudButton>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Dense="true"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 AriaLabel="@L["MenuAriaLabel"]">
            <MudMenuItem Icon="@LanguageIcon("en")" OnClick="@(() => SwitchCulture("en"))">
                @L["LanguageEnglish"]
            </MudMenuItem>
            <MudMenuItem Icon="@LanguageIcon("nb-NO")" OnClick="@(() => SwitchCulture("nb-NO"))">
                @L["LanguageNorwegianBokmal"]
            </MudMenuItem>
            <MudMenuItem Icon="@LanguageIcon("nn-NO")" OnClick="@(() => SwitchCulture("nn-NO"))">
                @L["LanguageNorwegianNynorsk"]
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string CurrentCulture => CultureInfo.CurrentUICulture.Name switch
    {
        "nb-NO" or "nb" => "nb-NO",
        "nn-NO" or "nn" => "nn-NO",
        _ => "en",
    };

    private string LanguageIcon(string culture) =>
        culture == CurrentCulture
            ? Icons.Material.Filled.Check
            : Icons.Material.Filled.Language;

    private void SwitchCulture(string culture)
    {
        if (culture == CurrentCulture)
        {
            return;
        }
        var redirectUri = new Uri(Nav.Uri).PathAndQuery;
        var target = $"/set-culture?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(redirectUri)}";
        Nav.NavigateTo(target, forceLoad: true);
    }

    /// <summary>
    /// Reset the form state via the shared view-model (Scoped DI). The HybridCache in
    /// Infrastructure is untouched, so a follow-up search/lookup is still served from cache.
    /// Also navigates to '/' so the browser URL drops any orgnr / name query strings.
    /// </summary>
    private void OnTitleClick()
    {
        ViewModel.Reset();
        if (!Nav.Uri.EndsWith("/", StringComparison.Ordinal))
        {
            Nav.NavigateTo("/");
        }
    }
}
