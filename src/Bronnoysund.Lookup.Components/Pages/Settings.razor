@page "/settings"
@using System.Globalization
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["SettingsTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["SettingsTitle"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">@L["SettingsDescription"]</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudSelect T="string" Label="@L["UiCultureLabel"]" Value="@_currentCulture"
                   ValueChanged="OnCultureChanged" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem Value="@("en")">@L["LanguageEnglish"]</MudSelectItem>
            <MudSelectItem Value="@("nb-NO")">@L["LanguageNorwegianBokmal"]</MudSelectItem>
            <MudSelectItem Value="@("nn-NO")">@L["LanguageNorwegianNynorsk"]</MudSelectItem>
        </MudSelect>
    </MudPaper>
</MudContainer>

@code {
    private string _currentCulture = "en";

    protected override void OnInitialized()
    {
        _currentCulture = CultureInfo.CurrentUICulture.Name switch
        {
            "nb-NO" or "nb" => "nb-NO",
            "nn-NO" or "nn" => "nn-NO",
            _ => "en",
        };
    }

    private void OnCultureChanged(string newCulture)
    {
        if (newCulture == _currentCulture)
        {
            return;
        }
        var redirectUri = new Uri(Nav.Uri).PathAndQuery;
        var target = $"/set-culture?culture={Uri.EscapeDataString(newCulture)}&redirectUri={Uri.EscapeDataString(redirectUri)}";
        Nav.NavigateTo(target, forceLoad: true);
    }
}
